<?php /** @var View $this **/ ?>

<h6 class="form-section-header"><?php $this->_('Pterodactyl.tab_actions.heading_actions'); ?></h6>
<div class="mb-3">
    <div class="options" id="pterodactyl_actions">
        <p>
            <?php $this->_('Pterodactyl.tab_actions.server_status'); ?> <span class="buff <?php echo isset($server->attributes->current_state) ? $this->Html->safe($server->attributes->current_state) : null; ?>"><?php $this->_('Pterodactyl.tab_actions.status_' . ($server->attributes->current_state ?? null)); ?></span>
        </p>

        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                ($client_id ?? null) .
                '/' .
                ($service_id ?? null) .
                '/tabActions/start/'
        ); ?>" class="start btn btn-success<?php echo ($server->attributes->current_state ?? null) != 'offline' ? ' disabled' : ''; ?>"><i class="bi bi-power"></i> <?php $this->_('Pterodactyl.!actions.start'); ?></a>
        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                ($client_id ?? null) .
                '/' .
                ($service_id ?? null) .
                '/tabActions/stop/'
        ); ?>" class="stop btn btn-danger<?php echo ($server->attributes->current_state ?? null) != 'running' ? ' disabled' : ''; ?>"><i class="bi bi-power"></i> <?php $this->_('Pterodactyl.!actions.stop'); ?></a>
        <a href="<?php echo $this->Html->safe(
            $this->base_uri .
                'clients/servicetab/' .
                ($client_id ?? null) .
                '/' .
                ($service_id ?? null) .
                '/tabActions/restart/'
        ); ?>" class="btn btn-outline-secondary<?php echo ($server->attributes->current_state ?? null) != 'running' ? ' disabled' : ''; ?>"><i class="bi bi-arrow-clockwise"></i> <?php $this->_('Pterodactyl.!actions.restart'); ?></a>
    </div>
</div>


<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        setPterodactylInterval('<?php echo Configure::get("Pterodactyl.page_refresh_rate_fast"); ?>', '');
        blestaSetHeadTag("link", {
            media: "screen",
            type: "text/css",
            rel: "stylesheet",
            href: "<?php echo $this->Html->safe($this->view_dir . 'css/styles.css'); ?>"
        });

        function setPterodactylInterval(pterodactyl_refresh_rate, pterodactyl_old_action_data) {
            var interval = '';
            interval = setInterval(function() {
                blestaRequest("GET",
                    '<?php echo $this->base_uri . 'clients/servicetab/' . ($client_id ?? null) . '/' . ($service_id ?? null) . '/tabActions/'; ?>',
                    null,
                    // Success response
                    function(data) {
                        if (data.replacer && data.content) {
                            var temp = document.createElement('div');
                            temp.innerHTML = data.content;
                            var html = temp.querySelector('#pterodactyl_actions').innerHTML;
                            document.getElementById('pterodactyl_actions').innerHTML = html;
                            pterodactyl_refresh_rate = (html == pterodactyl_old_action_data) ? '<?php echo Configure::get("Pterodactyl.page_refresh_rate"); ?>': '<?php echo Configure::get("Pterodactyl.page_refresh_rate_fast"); ?>';

                            clearInterval(interval);
                            setPterodactylInterval(pterodactyl_refresh_rate, html);
                        }
                    },
                    null, {
                        dataType: 'json'
                    }
                );
            }, pterodactyl_refresh_rate);
        }
    });
</script>